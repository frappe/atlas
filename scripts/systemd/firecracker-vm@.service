[Unit]
Description=Atlas Firecracker VM %i
After=network-online.target
Wants=network-online.target
# Do not auto-start a sleeping VM on host reboot. sleep-vm.py writes this
# marker after stopping the unit; wake-vm.py removes it before starting.
# The condition prevents the unit from starting while the file exists, without
# disabling WantedBy (so wake-vm.py's systemctl start works).
#
# The negation is `ConditionPathExists=!<path>`. It was written as
# `ConditionPathNotExists=`, WHICH IS NOT A SYSTEMD DIRECTIVE — systemd logs
# "Unknown key name ... ignoring" and starts the unit anyway, so this condition
# has never suppressed anything. Every sleeping VM cold-booted on the next host
# reboot with its marker still on disk, which then reads as Sleeping forever to
# anything that checks the marker first, and re-parks a running VM into the
# wake trap's black hole. A directive that does not exist fails open and says so
# only in the journal; `systemd-analyze verify` is what catches it.
ConditionPathExists=!/var/lib/atlas/virtual-machines/%i/sleeping

[Service]
Type=simple
# The jailer re-creates its per-launch artifacts inside the jail on EVERY start
# and aborts with EEXIST if any already exist — the device nodes it mknod()s
# (/dev/net/tun, /dev/kvm, ...) and the firecracker.pid it writes. The jail root
# persists on disk across stop/start, so a restart hits last boot's leftovers
# ("Failed to create /dev/net/tun via mknod: File exists", "Failed to open file
# /firecracker.pid: File exists"). Remove the jailer-owned dev/, the stale pid
# file, and the stale API socket so each start gets a clean jail to re-populate.
# The persistent rootfs/kernel/config are untouched. `-` prefix on dev/: a first
# boot has none yet, and that is not an error.
ExecStartPre=-/bin/rm -rf /var/lib/atlas/virtual-machines/%i/jail/firecracker/%i/root/dev
ExecStartPre=/bin/rm -f /var/lib/atlas/virtual-machines/%i/jail/firecracker/%i/root/firecracker.pid
ExecStartPre=/bin/rm -f /var/lib/atlas/virtual-machines/%i/jail/firecracker/%i/root/run/firecracker.socket
# Disk (re-activate the thin-snapshot LV and refresh the in-jail block node)
# must be present before the jailer opens rootfs.ext4. provision is not re-run
# on boot and `lvcreate -s` disks are activation-skip, so without this a reboot
# leaves the jail node dangling; vm-disk-up.py is idempotent and self-heals it.
# The hook imports the durable atlas package (its own sys.path shim adds its
# directory, /var/lib/atlas/bin) and takes the VM uuid as a positional arg.
# Runs under the Atlas venv python (/var/lib/atlas/venv/bin/python), not the host
# python3 — bootstrap's sanity gate py_compiles every hook on it first.
ExecStartPre=/var/lib/atlas/venv/bin/python /var/lib/atlas/bin/vm-disk-up.py %i
# Networking (netns + veth + in-namespace tap) must exist before the jailer
# joins the namespace; ExecStartPre runs to completion before ExecStart.
ExecStartPre=/var/lib/atlas/venv/bin/python /var/lib/atlas/bin/vm-network-up.py %i
# Run Firecracker under the jailer via the per-VM launcher that provision-vm.py
# generated. The launcher (not this unit) assembles the jailer argv, because the
# --cgroup cpu.max value carries an internal space that systemd's ExecStart
# word-splitting would shatter. The launcher de-privileges Firecracker to the
# per-VM uid/gid, chroots it into the per-VM jail, applies cgroup-v2 memory/cpu
# caps + fd/file rlimits, and joins the VM's own network namespace. It `exec`s
# the jailer, so the jailer is this unit's main process (see KillMode below).
ExecStart=/var/lib/atlas/virtual-machines/%i/jailer-launch.sh
# When snapshot-stop-vm.py left a complete memory snapshot (marker present),
# the launcher started Firecracker idle; this hook loads the snapshot, consumes
# the marker, and resumes the guest — milliseconds instead of a cold boot. On a
# cold boot (no marker) it exits 0 immediately. On a failed restore it removes
# the marker and exits non-zero: the unit fails, Restart=always relaunches it,
# and the marker-less launcher cold-boots — the fast path degrades to the
# default path on its own.
ExecStartPost=/var/lib/atlas/venv/bin/python /var/lib/atlas/bin/vm-restore.py %i
ExecStopPost=/var/lib/atlas/venv/bin/python /var/lib/atlas/bin/vm-network-down.py %i
StandardOutput=append:/var/lib/atlas/virtual-machines/%i/log/firecracker.log
StandardError=append:/var/lib/atlas/virtual-machines/%i/log/firecracker.log
Restart=always
RestartSec=5s
# The jailer is the unit's main process and Firecracker is its child; KillMode
# mixed sends SIGTERM to the jailer and SIGKILL to the whole control group, so
# the jailed Firecracker dies with the unit rather than being orphaned.
KillMode=mixed

[Install]
WantedBy=multi-user.target
