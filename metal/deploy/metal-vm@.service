[Unit]
Description=metal microVM %i
After=network.target
# metald manages this unit; it is not enabled directly.

[Service]
Type=exec
# metald writes this before starting the unit; it holds JAILER_ARGS.
EnvironmentFile=/var/lib/metal/vms/%i/jailer.env
# jailer sets up the chroot/cgroup/netns, drops privileges, then execs
# firecracker in place, so the tracked MainPID is firecracker.
ExecStart=/usr/bin/jailer $JAILER_ARGS
Restart=no

# Resource limits (MemoryMax/CPUQuota) are set per-instance by metald over
# D-Bus. Device access uses the default permissive policy for now; restricting
# it to /dev/kvm, /dev/net/tun and the per-VM disk is a hardening follow-up.
