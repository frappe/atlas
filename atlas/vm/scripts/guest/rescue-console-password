#!/usr/bin/python3
import secrets
import subprocess
import tempfile
from pathlib import Path

password = secrets.token_urlsafe(18)
subprocess.run(["chpasswd"], input=f"root:{password}\n", text=True, check=True, capture_output=True)
with tempfile.TemporaryDirectory(prefix=".atlas-rescue-", dir="/etc") as directory:
	issue = Path(directory) / "issue"
	issue.touch(mode=0o600)
	issue.write_text(
		"Atlas Rescue console\n"
		"Login: root\n"
		f"Temporary console password: {password}\n"
		"SSH uses your VM keys only. Run atlas-rescue-menu for guided repair.\n\n"
	)
	# Replace the inode so existing readers cannot read the new credential.
	issue.replace("/etc/issue")
