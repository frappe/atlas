#!/usr/bin/python3
import ipaddress
import pathlib
import socket
import subprocess
import time

METADATA_ADDRESS = ("169.254.169.254", 80)
METADATA_PATH_PREFIX = "/latest"
DROP_IN_PATH = pathlib.Path("/run/systemd/network/10-atlas.network.d/mesh.conf")
MESH_GATEWAY = "fe80::1"
MESH_PREFIX = "fdaa::/16"
# Matches the image routes outside the mesh, which can lead to a 1500-byte network.
OUTSIDE_MESH_MTU = 1380
TOKEN_TTL_SECONDS = "21600"
POLL_SECONDS = 0.25
TIMEOUT_SECONDS = 3
# A smaller gap is left to time sync, which slews the clock instead of stepping it.
CLOCK_STEP_THRESHOLD_SECONDS = 2


def content_length(head):
    for line in head.split(b"\r\n")[1:]:
        name, _, value = line.partition(b":")
        if name.strip().lower() == b"content-length":
            return int(value.strip())
    return 0


def read_response(connection):
    """Return the head and the complete body of one HTTP response."""
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = connection.recv(4096)
        if not chunk:
            raise OSError("the metadata service closed the connection")
        data += chunk

    head, _, body = data.partition(b"\r\n\r\n")
    length = content_length(head)
    while len(body) < length:
        chunk = connection.recv(4096)
        if not chunk:
            raise OSError("the metadata service sent a short body")
        body += chunk
    return head, body[:length]


def request(method, path, headers):
    """Return one MMDS response body, an empty string for a missing key, or None on failure."""
    lines = [f"{method} {METADATA_PATH_PREFIX}/{path} HTTP/1.1", "Host: metadata"]
    lines.extend(f"{name}: {value}" for name, value in headers.items())
    message = ("\r\n".join(lines) + "\r\n\r\n").encode()

    try:
        with socket.create_connection(METADATA_ADDRESS, TIMEOUT_SECONDS) as connection:
            connection.settimeout(TIMEOUT_SECONDS)
            connection.sendall(message)
            head, body = read_response(connection)
    except (OSError, ValueError):
        return None

    status = head.split(b"\r\n", 1)[0]
    if b" 404 " in status:
        return ""
    if b" 200 " not in status:
        return None
    return body.decode(errors="replace").strip()


def get_token():
    return request("PUT", "api/token", {"X-metadata-token-ttl-seconds": TOKEN_TTL_SECONDS})


def read(path, token):
    return request("GET", path, {"X-metadata-token": token})


def apply_host_time(value):
    """Step the clock forward to the host time that Metal sets before a memory restore.

    A restored guest keeps the clock of its snapshot until time sync reaches a server. The
    clock never steps back, so a value that is older than the guest clock does nothing.
    """
    try:
        host_time = int(value) / 1000
    except ValueError:
        return
    if host_time - time.time() > CLOCK_STEP_THRESHOLD_SECONDS:
        time.clock_settime(time.CLOCK_REALTIME, host_time)


def apply_hostname(hostname):
    if hostname == socket.gethostname():
        return
    # A failure before D-Bus starts is retried on the next poll.
    subprocess.run(["hostnamectl", "set-hostname", hostname], check=False)


def mesh_drop_in(address, routes, mtu):
    """Return the mesh address, the mesh MTU and the host routes of the guest."""
    drop_in = f"[Link]\nMTUBytes={mtu}\n\n" if mtu else ""
    drop_in += (
        "[Network]\n"
        f"Address={address}/128\n"
        "IPv6AcceptRA=no\n"
        "\n[Route]\n"
        f"Destination={MESH_PREFIX}\n"
        f"Gateway={MESH_GATEWAY}\n"
    )
    for destination in routes:
        drop_in += (
            "\n[Route]\n" f"Destination={destination}\n" f"Gateway={MESH_GATEWAY}\n" f"MTUBytes={OUTSIDE_MESH_MTU}\n"
        )

    return drop_in


def parse_routes(value):
    """Return the route destinations that the metadata service lists."""
    return [entry.strip() for entry in (value or "").split(",") if entry.strip()]


def apply_mesh_network(address, routes, mtu):
    drop_in = mesh_drop_in(ipaddress.IPv6Address(address), routes, mtu)
    if DROP_IN_PATH.exists() and DROP_IN_PATH.read_text() == drop_in:
        return

    # Netlink works before D-Bus starts. The drop-in preserves the state through networkd.
    if mtu:
        subprocess.run(["ip", "link", "set", "dev", "eth0", "mtu", str(mtu)], check=False)
        # The kernel raises each IPv6 route that carried the old link MTU, so pin ::/0 again.
        subprocess.run(
            ["ip", "-6", "route", "replace", "default", "via", MESH_GATEWAY, "dev", "eth0"]
            + ["proto", "static", "metric", "1024", "mtu", str(OUTSIDE_MESH_MTU)],
            check=False,
        )
    subprocess.run(["ip", "-6", "address", "replace", f"{address}/128", "dev", "eth0", "nodad"], check=False)
    subprocess.run(["ip", "-6", "route", "replace", MESH_PREFIX, "via", MESH_GATEWAY, "dev", "eth0"], check=False)
    for destination in routes:
        subprocess.run(
            ["ip", "-6", "route", "replace", destination, "via", MESH_GATEWAY, "dev", "eth0", "mtu", str(OUTSIDE_MESH_MTU)],
            check=False,
        )

    DROP_IN_PATH.parent.mkdir(parents=True, exist_ok=True)
    DROP_IN_PATH.write_text(drop_in)
    # Remove the file when networkd is not ready, so the next poll retries.
    if subprocess.run(["networkctl", "reload"], check=False).returncode != 0:
        DROP_IN_PATH.unlink()
        return
    reset_network_services()


def reset_network_services():
    """Reset services that remain backed off after a networkless warm snapshot."""
    subprocess.run(["resolvectl", "reset-server-features"], check=False)
    subprocess.run(["resolvectl", "flush-caches"], check=False)

    # Queued, not awaited: time sync takes seconds to stop, and the agent must keep polling.
    subprocess.run(["systemctl", "restart", "--no-block", "systemd-timesyncd"], check=False)


def main():
    """Watch MMDS and apply metadata changes."""
    token = ""
    while True:
        if not token:
            token = get_token()
        if token:
            hostname = read("meta-data/local-hostname", token)
            address = read("meta-data/mesh-ipv6", token)
            if not hostname and not address:
                token = ""
            else:
                # First, so the network services that the identity change restarts read the right time.
                host_time = read("meta-data/host-time-unix-ms", token)
                if host_time:
                    apply_host_time(host_time)
                if hostname:
                    apply_hostname(hostname)
                routes = read("meta-data/host-routes", token)
                # Metal before the mesh MTU setting has no key, so the image MTU stays.
                mtu = read("meta-data/mesh-mtu", token)
                # A failed read keeps the current network, because an empty value would remove routes or the MTU.
                if address and routes is not None and mtu is not None:
                    apply_mesh_network(address, parse_routes(routes), int(mtu) if mtu else None)
        time.sleep(POLL_SECONDS)


main()
