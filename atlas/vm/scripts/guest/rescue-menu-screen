#!/usr/bin/python3
import curses
import locale
import sys
import time
from typing import NamedTuple

WIDTH = 68
MOUNT_PATH = "/mnt/original"
SECTIONS = (
	(
		"Your disk",
		(
			("mount", "Mount your VM disk", f"Opens it at {MOUNT_PATH} to look around or repair it."),
			("usage", "See what is using disk space", "Lists the largest folders."),
		),
	),
	(
		"Find the problem",
		(
			("errors", "See errors from the last boot", "Shows why your system may have failed to start."),
			("logs", "Read system logs", "Opens the logs of your system."),
			("check", "Check the disk for errors", "Reads the filesystem and changes nothing."),
		),
	),
	(
		"Fix the problem",
		(
			("repair", "Repair disk errors", "Fixes the filesystem. Take a snapshot first."),
			("grow", "Expand the filesystem to the full disk", "Use this after a disk resize."),
			("fstab", "Edit /etc/fstab", "Fixes mount settings that stop your system booting."),
		),
	),
	(
		"Get back in",
		(
			("password", "Reset a user password", "Sets a new password for an account."),
			("keys", "Add this VM's SSH keys to a user", "Keeps the keys that the account has now."),
			("firewall", "Turn off the firewall in your system", "Use this if the firewall locked you out."),
		),
	),
	(
		"Advanced",
		(
			("chroot", "Open a shell inside your system", "Runs commands as if your system had booted."),
			("shell", "Open a rescue shell", "Runs commands in the rescue system."),
		),
	),
)


class Row(NamedTuple):
	key: str = ""
	number: int = 0
	label: str = ""
	description: str = ""

	@property
	def is_heading(self) -> bool:
		return bool(self.label) and not self.key


class Palette(NamedTuple):
	base: int
	accent: int
	muted: int
	selected: int
	mounted: int
	unmounted: int


def create_palette() -> Palette:
	if not curses.has_colors():
		return Palette(
			curses.A_NORMAL, curses.A_BOLD, curses.A_DIM, curses.A_REVERSE, curses.A_REVERSE, curses.A_REVERSE
		)
	has_many_colors = curses.COLORS >= 256
	accent = 80 if has_many_colors else curses.COLOR_CYAN
	pairs = (
		(curses.COLOR_WHITE, curses.COLOR_BLACK),
		(accent, curses.COLOR_BLACK),
		(244 if has_many_colors else curses.COLOR_WHITE, curses.COLOR_BLACK),
		(curses.COLOR_BLACK, accent),
		(curses.COLOR_BLACK, curses.COLOR_GREEN),
		(curses.COLOR_BLACK, curses.COLOR_YELLOW),
	)
	for number, (foreground, background) in enumerate(pairs, start=1):
		curses.init_pair(number, foreground, background)
	base, accent_pair, muted, selected, mounted, unmounted = (curses.color_pair(n) for n in range(1, 7))
	return Palette(
		base, accent_pair, muted if has_many_colors else muted | curses.A_DIM, selected, mounted, unmounted
	)


def build_rows(is_mounted: bool, has_gaps: bool) -> list[Row]:
	rows: list[Row] = []
	number = 0
	for index, (heading, items) in enumerate(SECTIONS):
		if index and has_gaps:
			rows.append(Row())
		rows.append(Row(label=heading))
		for key, label, description in items:
			number += 1
			if key == "mount" and is_mounted:
				label, description = "Unmount your VM disk", f"Closes it at {MOUNT_PATH}."
			rows.append(Row(key, number, label, description))
	return rows


def draw_separator(window: curses.window, line: int, width: int, palette: Palette) -> None:
	window.hline(line, 1, curses.ACS_HLINE | palette.accent, width - 2)
	window.addch(line, 0, curses.ACS_LTEE, palette.accent)
	window.addch(line, width - 1, curses.ACS_RTEE, palette.accent)


def draw_row(
	window: curses.window, line: int, width: int, row: Row, is_selected: bool, palette: Palette
) -> None:
	text_width = width - 6
	if is_selected:
		window.addnstr(
			line,
			3,
			f" {row.number:>2}  {row.label}".ljust(text_width),
			text_width,
			palette.selected | curses.A_BOLD,
		)
	elif row.key:
		window.addstr(line, 3, f" {row.number:>2}", palette.accent)
		window.addnstr(line, 8, row.label, text_width - 5, palette.base)
	elif row.is_heading:
		window.addstr(line, 3, row.label, palette.muted)
		window.hline(
			line, 4 + len(row.label), curses.ACS_HLINE | palette.muted, text_width - len(row.label) - 1
		)


def draw_footer(window: curses.window, line: int, width: int, palette: Palette) -> None:
	move = "↑↓" if locale.getencoding().lower().replace("-", "") == "utf8" else "Up/Down"
	items = ((move, "Move"), ("Enter", "Select"), ("Esc", "Exit"))
	column = (width - sum(len(key) + len(action) + 1 for key, action in items) - 4 * (len(items) - 1)) // 2
	for key, action in items:
		window.addstr(line, column, key, palette.accent | curses.A_BOLD)
		column += len(key) + 1
		window.addstr(line, column, action, palette.muted)
		column += len(action) + 4


def run_menu(screen: curses.window, default: str, details: str, state: str) -> str:
	curses.set_escdelay(25)
	curses.curs_set(0)
	palette = create_palette()
	screen.bkgd(" ", palette.base)

	is_mounted = state != "unmounted"
	status = f" Mounted {state} " if is_mounted else " Not mounted "
	status_color = (palette.mounted if is_mounted else palette.unmounted) | curses.A_BOLD
	selected_key = default
	offset = 0
	typed, typed_at = "", 0.0

	while True:
		screen_height, screen_width = screen.getmaxyx()
		has_room = screen_height >= len(build_rows(is_mounted, True)) + 8
		rows = build_rows(is_mounted, has_room)
		choices = [index for index, row in enumerate(rows) if row.key]
		selected = next((index for index in choices if rows[index].key == selected_key), choices[0])

		# A short terminal, such as the 24 rows of a serial console, shows the disk in the title row.
		header_height = 3 if has_room else 1
		chrome = header_height + 5
		height = min(screen_height, len(rows) + chrome)
		width = min(screen_width, WIDTH)
		visible = height - chrome
		# Keep the section heading on screen with the first item of a section.
		offset = min(offset, selected - 1 if rows[selected - 1].is_heading else selected)
		offset = max(offset, selected - visible + 1)

		screen.erase()
		window = curses.newwin(height, width, (screen_height - height) // 2, (screen_width - width) // 2)
		window.bkgd(" ", palette.base)
		window.attron(palette.accent)
		window.box()
		window.attroff(palette.accent)
		window.addstr(0, 2, " Atlas Rescue ", palette.accent | curses.A_BOLD)
		if has_room:
			window.addnstr(1, 3, f"VM disk  /dev/vdb  {details}", width - 8 - len(status), curses.A_BOLD)
			window.addstr(1, width - 3 - len(status), status, status_color)
			draw_separator(window, 2, width, palette)
		else:
			window.addnstr(0, 17, f" /dev/vdb  {details} ", width - 22 - len(status), curses.A_BOLD)
			window.addstr(0, width - 3 - len(status), status, status_color)
		for line, row in enumerate(rows[offset : offset + visible], start=header_height):
			draw_row(window, line, width, row, offset + line - header_height == selected, palette)
		if offset:
			window.addstr(header_height, width - 9, " more ", palette.muted)
		if offset + visible < len(rows):
			window.addstr(header_height + visible - 1, width - 9, " more ", palette.muted)

		window.addnstr(height - 4, 3, rows[selected].description, width - 6, palette.accent)
		draw_footer(window, height - 2, width, palette)
		screen.noutrefresh()
		window.noutrefresh()
		curses.doupdate()

		key = screen.getch()
		position = choices.index(selected)
		if key in (curses.KEY_UP, ord("k")):
			selected_key = rows[choices[(position - 1) % len(choices)]].key
		elif key in (curses.KEY_DOWN, ord("j")):
			selected_key = rows[choices[(position + 1) % len(choices)]].key
		elif key in (curses.KEY_ENTER, 10, 13):
			return rows[selected].key
		elif key in (27, ord("q")):
			return ""
		elif ord("0") <= key <= ord("9"):
			# Numbers move the cursor. A second digit within a second makes 10 to 13.
			now = time.monotonic()
			candidate = typed + chr(key) if now - typed_at < 1 else chr(key)
			if not 1 <= int(candidate) <= len(choices):
				candidate = chr(key)
			typed, typed_at = candidate, now
			if 1 <= int(candidate) <= len(choices):
				selected_key = rows[choices[int(candidate) - 1]].key


def main() -> None:
	"""Show the main menu and print the selected key to standard error, which the menu script captures."""
	locale.setlocale(locale.LC_ALL, "")
	default, details, state = sys.argv[1:]
	print(curses.wrapper(run_menu, default, details, state), file=sys.stderr)


main()
